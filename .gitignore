# ==========================================================================
# AI IELTS Tutor — monorepo .gitignore
# ==========================================================================

# ---------- Environment / secrets (NEVER commit) ----------
.env
.env.*
*.env
# ...but always keep the templates:
!.env.example
!**/.env.example

# ---------- Node / React Native (frontend) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/
*.tgz

# Metro / RN
.metro-health-check*
metro.config.js.bak
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/*.keystore
!frontend/android/app/debug.keystore
frontend/ios/build/
frontend/ios/Pods/
frontend/ios/*.xcworkspace/xcuserdata/
*.jsbundle
frontend/.bundle-check/

# ---------- Python (backend) ----------
*.db
*.sqlite3
backend/dev.db
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Editors / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.iml

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs / temp ----------
*.log
logs/
tmp/
.cache/

# Synthesised TTS audio: regenerable, binary, and potentially large.
backend/media/tts-cache/

# Synthesised TTS audio and stored recordings: regenerable or user data,
# neither belongs in git.
backend/media/recordings/
