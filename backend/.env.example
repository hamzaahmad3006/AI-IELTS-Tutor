# Backend environment (copy to .env). Secrets injected at runtime.
APP_ENV=development
API_V1_PREFIX=/v1
LOG_LEVEL=INFO

# Security
JWT_SECRET=change_me
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Database (Supabase PostgreSQL — used ONLY as Postgres)
#
# Use the CONNECTION POOLER host, not the direct one. Supabase's direct endpoint
# (db.<project-ref>.supabase.co) resolves to IPv6 only, so on an IPv4-only
# network every connection fails — on Windows with the opaque
# "[WinError 121] The semaphore timeout period has expired". The pooler is
# dual-stack and works everywhere.
#
#   host: aws-<n>-<region>.pooler.supabase.com   (Dashboard > Connect > pooler)
#   user: postgres.<project-ref>                 (note the dotted suffix)
#   port: 5432 = session mode, 6543 = transaction mode
#
# Special characters in the password must be URL-encoded ('@' -> %40).
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:pass@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# AI (provider-agnostic)
# AI_PROVIDER=groq uses GROQ_API_KEY below.
AI_PROVIDER=groq
GROQ_API_KEY=change_me

# Any OpenAI-compatible endpoint, as a fallback or a replacement. Set
# AI_PROVIDER to openai | together | openrouter | fireworks and supply
# LLM_API_KEY -- the URL and a default model come with the name. LLM_MODEL
# overrides that default.
#
# For a self-hosted gateway or anything not listed, set
# AI_PROVIDER=openai-compatible and give all three of LLM_API_KEY,
# LLM_BASE_URL and LLM_MODEL.
#
# AI_PROVIDER=anthropic and AI_PROVIDER=gemini also read LLM_API_KEY. They have
# their own adapters because their APIs differ (system prompts, usage fields,
# how JSON is requested), but they are configured the same way from here.
# LLM_MODEL and LLM_BASE_URL override their defaults if set.
#
# Anything unconfigured falls back to the offline mock, so a missing key is a
# visibly fake score rather than a dead endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Rate limiting (in-memory per-process; front with Redis for multi-instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_AI_PER_MIN=20

# ---------------------------------------------------------------------------
# Voice pipeline (optional). Both default to a mock, so leaving these unset
# gives you a working app with silent placeholder audio and no bills.
# ---------------------------------------------------------------------------

# Speech-to-text. Deepgram bills per second of audio (~$0.004/min), so a
# 12-minute exam is a few cents.
STT_PROVIDER=mock
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Text-to-speech.
#
# TTS_PROVIDER=deepgram uses Aura on the SAME key as transcription above, and
# returns raw PCM at 16 kHz -- exactly what the LiveKit transport publishes, so
# the real-time path needs no audio decoder and no second vendor. This is the
# option to use for the live interview.
DEEPGRAM_VOICE=aura-2-thalia-en

# TTS_PROVIDER=elevenlabs is the alternative for the recorded question bank.
# The free tier is 10,000 characters a month and one exam speaks roughly
# 1,200-1,500 of them. Output is MP3, which the LiveKit transport refuses
# because it cannot be decoded to PCM without a native library. Synthesised
# audio is cached by text+voice+model, so a fixed bank is paid for once.
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_CACHE_DIR=media/tts-cache

# Checked BEFORE each request, so an overrun is refused rather than billed.
# 0 disables the ceiling entirely.
ELEVENLABS_MONTHLY_CHAR_LIMIT=9000

# ---------------------------------------------------------------------------
# Crash reporting. Off without a DSN, which is the default.
#
# The payload is built by allowlist in core/crash_reporting.py: exception type,
# a scrubbed message, stack frames reduced to file/function/line, the route
# template and the correlation id. No request bodies, no headers, no frame
# locals -- in this app those are the learner's essay, the bearer token and the
# provider keys, and an off-the-shelf reporter would send all three.
SENTRY_DSN=
# Groups events by deploy; a commit sha is the usual value.
SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Object storage. Local disk by default and it needs nothing. Set
# STORAGE_BACKEND=cloudinary to serve media from Cloudinary, so audio playback
# does not stream through an API worker.
#
# Credentials are on the Cloudinary dashboard. The API secret signs every
# request and belongs in .env only -- never in the app, and never in a URL.
#
# Recordings (keys under recordings/) are uploaded as `authenticated` and
# served through expiring download URLs, because they are somebody's voice.
# Seeded listening clips and chart assets are `upload` and served straight
# from the CDN, since they are identical for every learner.
#
# A half-filled config falls back to local rather than failing to start.
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional prefix, so one account can host staging and production without a
# staging deletion reaching production objects.
CLOUDINARY_FOLDER=

# ---------------------------------------------------------------------------
# LiveKit (real-time voice). Leave blank to disable the live interview; the
# upload-based speaking path still works without it.
#
# Two ways to get a server. They differ only in these values.
#
# 1. LiveKit Cloud (cloud.livekit.io, free tier, no card). Simplest, and the
#    phone reaches it over the internet rather than your Wi-Fi -- so URL and
#    PUBLIC_URL are the same, and there is no LAN address to get wrong:
#      LIVEKIT_URL=wss://<project>.livekit.cloud
#      LIVEKIT_PUBLIC_URL=wss://<project>.livekit.cloud
#    Note wss:// not ws:// -- Cloud is TLS-only and a plain ws:// fails with a
#    handshake error that reads like a bad token.
#
# 2. Self-hosted:  docker compose up livekit
#    Then the two URLs differ, because a phone cannot resolve "localhost" or
#    the compose service name:
#      LIVEKIT_URL=ws://localhost:7880          (how the BACKEND reaches it)
#      LIVEKIT_PUBLIC_URL=ws://192.168.1.20:7880 (how the PHONE reaches it)
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=

# Cloud: from Settings > Keys in the dashboard. The secret is shown once, at
# creation, and cannot be read again afterwards.
#
# Self-hosted: `--dev` mode accepts devkey/secret, which are published in
# LiveKit's own documentation -- fine on a machine nothing else can reach, and
# an open server anywhere else. The environment check refuses to start staging
# or production while they are still set.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Environment. development | staging | production
#
# Staging and production are held to the same rules, and the app REFUSES TO
# START if any of these are still development defaults:
#   - JWT_SECRET published in the repo, or shorter than 32 characters
#   - SEED_ADMIN_PASSWORD published in the repo
#   - LIVEKIT_API_KEY/SECRET still devkey/secret
#   - DATABASE_URL pointing at SQLite
#   - CORS_ORIGINS set to '*'
#   - RATE_LIMIT_ENABLED false
#
# Interactive docs (/docs, /redoc, /openapi.json) are served in development
# only. It fails closed: an unrecognised APP_ENV is treated as production.
# ---------------------------------------------------------------------------
APP_ENV=development

# Comma-separated origins allowed to call this API. '*' is a development
# convenience; with credentials enabled browsers reject it anyway.
CORS_ORIGINS=*

# Run periodic maintenance jobs (retention sweep, weakness decay) in this
# process. Off by default: with several API instances every one would start a
# scheduler. The database lock makes that safe, but it is still N processes
# waking to do nothing — enable on one instance or a dedicated worker.
JOBS_ENABLED=false

# OTLP endpoint for traces, e.g. http://localhost:4318/v1/traces
# Blank disables tracing: spans with nowhere to go still cost work and buffer
# into a queue nobody drains. Health, ready and metrics are never traced —
# polled every few seconds, they would drown the trace view.
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=ai-ielts-tutor-api

# Keep interview recordings after transcribing, so a learner can replay what
# they actually said next to the transcript. Off by default: storing someone's
# voice is a decision, not a side effect. Recordings are served only through
# short-lived signed URLs.
KEEP_RECORDINGS=false
