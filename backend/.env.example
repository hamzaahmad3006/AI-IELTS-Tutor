# Backend environment (copy to .env). Secrets injected at runtime.
APP_ENV=development
API_V1_PREFIX=/v1
LOG_LEVEL=INFO

# Security
JWT_SECRET=change_me
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Database (Supabase PostgreSQL — used ONLY as Postgres)
#
# Use the CONNECTION POOLER host, not the direct one. Supabase's direct endpoint
# (db.<project-ref>.supabase.co) resolves to IPv6 only, so on an IPv4-only
# network every connection fails — on Windows with the opaque
# "[WinError 121] The semaphore timeout period has expired". The pooler is
# dual-stack and works everywhere.
#
#   host: aws-<n>-<region>.pooler.supabase.com   (Dashboard > Connect > pooler)
#   user: postgres.<project-ref>                 (note the dotted suffix)
#   port: 5432 = session mode, 6543 = transaction mode
#
# Special characters in the password must be URL-encoded ('@' -> %40).
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:pass@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# AI (provider-agnostic)
AI_PROVIDER=groq
GROQ_API_KEY=change_me

# Rate limiting (in-memory per-process; front with Redis for multi-instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_AI_PER_MIN=20

# ---------------------------------------------------------------------------
# Voice pipeline (optional). Both default to a mock, so leaving these unset
# gives you a working app with silent placeholder audio and no bills.
# ---------------------------------------------------------------------------

# Speech-to-text. Deepgram bills per second of audio (~$0.004/min), so a
# 12-minute exam is a few cents.
STT_PROVIDER=mock
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Text-to-speech. This is the expensive half: the free tier is 10,000
# characters a month and one exam speaks roughly 1,200-1,500 of them.
# Synthesised audio is cached by text+voice+model, so a fixed question bank is
# paid for once and every later exam is free.
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_CACHE_DIR=media/tts-cache

# Checked BEFORE each request, so an overrun is refused rather than billed.
# 0 disables the ceiling entirely.
ELEVENLABS_MONTHLY_CHAR_LIMIT=9000

# ---------------------------------------------------------------------------
# LiveKit (self-hosted, real-time voice). Start it with:
#   docker compose up livekit
# Leave blank to disable the real-time path; the upload-based one still works.
# ---------------------------------------------------------------------------

# Where the BACKEND reaches LiveKit. Inside docker compose this is the service
# name; running the API outside Docker it is localhost.
LIVEKIT_URL=ws://localhost:7880

# Where the PHONE reaches LiveKit. A device on your Wi-Fi cannot resolve
# "localhost" or "livekit" — put your machine's LAN address here, e.g.
# ws://192.168.1.20:7880
LIVEKIT_PUBLIC_URL=

# --dev mode publishes these exact values in LiveKit's documentation, so they
# are safe only on a machine nothing else can reach. Generate real ones for
# any deployment.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------------------------------------------------------------------------
# Environment. development | staging | production
#
# Staging and production are held to the same rules, and the app REFUSES TO
# START if any of these are still development defaults:
#   - JWT_SECRET published in the repo, or shorter than 32 characters
#   - SEED_ADMIN_PASSWORD published in the repo
#   - LIVEKIT_API_KEY/SECRET still devkey/secret
#   - DATABASE_URL pointing at SQLite
#   - CORS_ORIGINS set to '*'
#   - RATE_LIMIT_ENABLED false
#
# Interactive docs (/docs, /redoc, /openapi.json) are served in development
# only. It fails closed: an unrecognised APP_ENV is treated as production.
# ---------------------------------------------------------------------------
APP_ENV=development

# Comma-separated origins allowed to call this API. '*' is a development
# convenience; with credentials enabled browsers reject it anyway.
CORS_ORIGINS=*

# Run periodic maintenance jobs (retention sweep, weakness decay) in this
# process. Off by default: with several API instances every one would start a
# scheduler. The database lock makes that safe, but it is still N processes
# waking to do nothing — enable on one instance or a dedicated worker.
JOBS_ENABLED=false

# OTLP endpoint for traces, e.g. http://localhost:4318/v1/traces
# Blank disables tracing: spans with nowhere to go still cost work and buffer
# into a queue nobody drains. Health, ready and metrics are never traced —
# polled every few seconds, they would drown the trace view.
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=ai-ielts-tutor-api
