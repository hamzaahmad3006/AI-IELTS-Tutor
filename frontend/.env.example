# Frontend environment (copy to .env). Do NOT commit the real .env.
#
# NOTE: React Native does not read .env automatically. To consume these values
# install `react-native-config` and import from it; otherwise they document the
# defaults currently hardcoded in src/api/config.ts.

# API base URL
#   Android emulator -> host machine:  http://10.0.2.2:8000/v1
#   iOS simulator    -> host machine:  http://localhost:8000/v1
#   Physical device  -> your LAN IP:   http://192.168.x.x:8000/v1
API_BASE_URL=http://10.0.2.2:8000/v1

# Use typed local mock data instead of the backend (true/false)
USE_MOCK=true

# Voice (LiveKit) — future
LIVEKIT_URL=
