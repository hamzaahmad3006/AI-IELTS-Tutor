<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+). The launcher masks the layers to whatever shape the
  device theme uses (circle, squircle, rounded square), so the mark lives in the
  centre 66% safe zone of the foreground and the background is a flat brand fill.
  Legacy raster icons in mipmap-* still serve API 24-25.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
