{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@api": ["src/api"],
      "@api/*": ["src/api/*"],
      "@components": ["src/components"],
      "@components/*": ["src/components/*"],
      "@constants": ["src/constants"],
      "@constants/*": ["src/constants/*"],
      "@navigation": ["src/AppNavigation"],
      "@navigation/*": ["src/AppNavigation/*"],
      "@redux": ["src/redux"],
      "@redux/*": ["src/redux/*"],
      "@screens/*": ["src/screens/*"],
      "@assets": ["src/assets"],
      "@models": ["src/types"],
      "@fixtures": ["src/api/mock/fixtures"],
      "@models/*": ["src/types/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
